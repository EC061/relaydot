# Generate with: openssl rand -base64 32
RELAYDOT_ADMIN_TOKEN=change-me-before-starting
# Public URL browsers use to reach the controller, including scheme. Sign-in
# and every administrator request are restricted to this origin, and the
# session cookie is marked Secure when it is https.
RELAYDOT_PUBLIC_URL=https://relaydot.example.com
# Encrypts operator secrets at rest, currently the shared WebDAV password.
# Generate with: openssl rand -base64 32
# Leave unset to derive it from RELAYDOT_ADMIN_TOKEN, in which case rotating
# that token requires re-entering the WebDAV password.
RELAYDOT_SECRET_KEY=
# How often to re-read the shared object store for new conversation history.
# Five- or six-field cron, or Honker's `@every <n><unit>` form.
RELAYDOT_INGEST_SCHEDULE=@every 5m
# Optional provider credentials for the scheduled model-discovery check. The
# catalog works without them: discovery is skipped and rates are approved by
# hand, which is the only way a rate enters the catalog either way.
RELAYDOT_SECRETS_OPENAI_API_KEY=
RELAYDOT_SECRETS_ANTHROPIC_API_KEY=
# Keep loopback when a reverse proxy runs on the host. Change deliberately for
# direct LAN access and firewall the port.
RELAYDOT_BIND_ADDRESS=127.0.0.1
RELAYDOT_PORT=3000
RELAYDOT_IMAGE=ghcr.io/ec061/relaydot-controller:latest
